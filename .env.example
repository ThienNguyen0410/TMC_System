PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=TMC_DB
DB_USER=postgres
DB_PASSWORD=

# Used by node-pg-migrate
DATABASE_URL=postgres://postgres:password@localhost:5432/TMC_DB

# Auth
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
APP_BASE_URL=http://localhost:5173
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173

# SMTP (leave empty to log reset links to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TMC System <no-reply@tmc.local>"

# Report (optional, these are the defaults)
# Named IANA zone only; it decides which local day an attendance event belongs to.
REPORT_TIME_ZONE=Asia/Ho_Chi_Minh
# Check-ins after this HH:mm:ss time count as late.
REPORT_LATE_AFTER=09:00:00

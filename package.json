{
  "name": "tmc-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node --watch --experimental-strip-types src/backend/server.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --experimental-strip-types --test \"src/backend/**/*.test.ts\"",
    "preview": "vite preview",
    "db:migrate": "node-pg-migrate -m src/database/migrations --envPath .env up",
    "db:rollback": "node-pg-migrate -m src/database/migrations --envPath .env down",
    "db:new": "node-pg-migrate create --envPath .env --migration-file-language sql --migration-filename-format index -m src/database/migrations",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait db && npm run db:migrate"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.6.7",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jose": "^6.2.15",
    "jsqr": "^1.4.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "node-pg-migrate": "^7.6.1",
    "oxlint": "^1.88.0",
    "sass": "^1.106.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
